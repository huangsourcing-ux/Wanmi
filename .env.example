IDENTITY_REBIND_COOLDOWN_SECONDS=2592000
WECHAT_QR_TTL_SECONDS=300
WECHAT_QR_POLL_MIN_INTERVAL_MS=800
DOMAIN_EXPIRY_REMINDER_DAYS=30,7,1
MOCK_SMS_OTP_CODE=246810
