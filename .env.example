# Local-only defaults. Never place production credentials in this file.
NODE_ENV=development
# Production must set this exact public origin to https://wanmi.net.
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3100
DATABASE_URL=postgresql://wanmi:wanmi_local_only@127.0.0.1:55432/wanmi
PAYLOAD_SECRET=replace-with-32-byte-local-secret
SESSION_PEPPER=replace-with-32-byte-local-pepper
TOTP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
CUSTOMER_SESSION_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_PHONE_LIMIT_PER_HOUR=5
OTP_IP_LIMIT_PER_HOUR=20
OTP_DEVICE_LIMIT_PER_HOUR=10
OTP_GLOBAL_LIMIT_PER_HOUR=1000
CUSTOMER_SESSION_COOKIE=wanmi_customer_session
WHO_DAT_URL=http://127.0.0.1:8080
WHO_DAT_AUTH_KEY=local-who-dat-only
PUBLIC_STORAGE_MODE=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=wanmi-public
S3_ACCESS_KEY_ID=wanmi-minio
S3_SECRET_ACCESS_KEY=wanmi-minio-local-only
S3_FORCE_PATH_STYLE=true
ALIYUN_SMS_MODE=mock
MOCK_SMS_OTP_CODE=246810
ALIYUN_KMS_MODE=mock
ALIYUN_OSS_REALNAME_MODE=mock
ALLOW_REAL_PROVIDER_WRITES=false
# ALIBABA_CLOUD_ACCESS_KEY_ID=
