# Local-only defaults. Never place production credentials in this file.
NODE_ENV=development
# Production must set this exact public origin to https://wanmi.net.
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3100
DATABASE_URL=postgresql://wanmi:wanmi_local_only@127.0.0.1:55432/wanmi
FIRST_PARTY_EVENT_LIMIT_PER_MINUTE=1000
FORM_SUBMISSION_IP_LIMIT_PER_HOUR=10
FORM_SUBMISSION_GLOBAL_LIMIT_PER_HOUR=500
PAYLOAD_SECRET=replace-with-32-byte-local-secret
SESSION_PEPPER=replace-with-32-byte-local-pepper
TOTP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# REALNAME_DOCUMENT_MASTER_KEYS=
# REALNAME_DOCUMENT_MASTER_KEY_VERSION=
CUSTOMER_SESSION_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_PHONE_LIMIT_PER_HOUR=5
OTP_IP_LIMIT_PER_HOUR=20
OTP_DEVICE_LIMIT_PER_HOUR=10
OTP_GLOBAL_LIMIT_PER_HOUR=1000
CUSTOMER_SESSION_COOKIE=wanmi_customer_session
DNS_TIMEOUT_MS=3000
DNS_RESPONSE_MAX_BYTES=65536
DNS_READ_RATE_PER_SECOND=20
DNS_READ_BURST=40
DNS_READ_MAX_CONCURRENCY=8
DNS_READ_QUEUE_CAPACITY=64
DNS_READ_QUEUE_WAIT_MS=2000
DNS_CACHE_MAX_ENTRIES=4096
DNS_CACHE_MAX_TTL_MS=60000
DNS_NEGATIVE_CACHE_MAX_TTL_MS=30000
DNS_MAX_TARGETS_PER_REQUEST=16
DNS_RECORD_MAX_PER_DOMAIN=100
DNS_RECORD_CHANGE_LIMIT_PER_MINUTE=20
DNS_RECORD_PREVIEW_TTL_SECONDS=300
TLS_TIMEOUT_MS=5000
TLS_HANDSHAKE_MAX_BYTES=262144
TLS_READ_RATE_PER_SECOND=10
TLS_READ_BURST=20
TLS_READ_MAX_CONCURRENCY=4
TLS_READ_QUEUE_CAPACITY=32
TLS_READ_QUEUE_WAIT_MS=2000
TLS_CACHE_MAX_ENTRIES=2048
TLS_RESULT_CACHE_TTL_MS=60000
TLS_EMPTY_CACHE_TTL_MS=30000
WESTDIGITAL_READ_RATE_PER_SECOND=2
WESTDIGITAL_READ_BURST=4
WESTDIGITAL_READ_QUEUE_CAPACITY=32
WESTDIGITAL_READ_QUEUE_WAIT_MS=5000
WESTDIGITAL_READ_TIMEOUT_MS=5000
WESTDIGITAL_READ_RESPONSE_MAX_BYTES=65536
WESTDIGITAL_AVAILABILITY_CACHE_TTL_MS=45000
WESTDIGITAL_AVAILABILITY_CACHE_MAX_ENTRIES=5000
WESTDIGITAL_PRICE_CACHE_TTL_MS=3600000
WESTDIGITAL_PRICE_CACHE_MAX_ENTRIES=512
WESTDIGITAL_WHOIS_FALLBACK_ENABLED=false
WESTDIGITAL_MODE=fixture
# WESTDIGITAL_USERNAME=
# WESTDIGITAL_API_PASSWORD=
WESTDIGITAL_WRITE_DOMAIN_ALLOWLIST=
WESTDIGITAL_WRITE_MAX_REGISTER_RENEW_OPERATIONS=0
WESTDIGITAL_WRITE_SINGLE_AMOUNT_LIMIT_FEN=0
WESTDIGITAL_WRITE_CUMULATIVE_AMOUNT_LIMIT_FEN=0
WHO_DAT_URL=http://127.0.0.1:8080
WHO_DAT_AUTH_KEY=local-who-dat-only
WHO_DAT_TIMEOUT_MS=5500
WHO_DAT_RESPONSE_MAX_BYTES=65536
WHO_DAT_READ_RATE_PER_SECOND=5
WHO_DAT_READ_BURST=10
WHO_DAT_READ_QUEUE_CAPACITY=32
WHO_DAT_READ_QUEUE_WAIT_MS=3000
PUBLIC_STORAGE_MODE=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=wanmi-public
S3_ACCESS_KEY_ID=wanmi-minio
S3_SECRET_ACCESS_KEY=wanmi-minio-local-only
S3_FORCE_PATH_STYLE=true
ALIYUN_SMS_MODE=mock
ALIYUN_CAPTCHA_MODE=fixture
CUSTOMER_PHONE_IDENTITY_INSTANCE_ID=wanmi-sms-cn
CUSTOMER_AUTH_FLOW_COOKIE=wanmi_auth_flow
