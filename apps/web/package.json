{
  "name": "@wanmi/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "build": "cross-env NODE_OPTIONS='--no-deprecation --max-old-space-size=1536' next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --hostname 127.0.0.1 --port 3100",
    "generate": "pnpm generate:types && pnpm generate:importmap",
    "generate:idna": "node scripts/generate-idna2008-ranges.mjs",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint . --max-warnings 0",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "vitest run --config vitest.config.mts tests/unit",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:integration": "vitest run --config vitest.config.mts tests/integration",
    "typecheck": "tsc --noEmit",
    "verify-generated": "node scripts/verify-generated.mjs",
    "verify:cloud:oss": "tsx scripts/verify-real-oss.ts",
    "worker": "cross-env NODE_OPTIONS=--no-deprecation payload jobs:run --cron '* * * * *' --all-queues --limit 1 --handle-schedules"
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "4.6.0",
    "@alicloud/kms20160120": "3.1.0",
    "@alicloud/openapi-core": "1.0.8",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/plugin-form-builder": "3.86.0",
    "@payloadcms/plugin-redirects": "3.86.0",
    "@payloadcms/plugin-seo": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-s3": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "ali-oss": "6.23.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cross-env": "7.0.3",
    "dotenv": "16.4.7",
    "graphql": "16.11.0",
    "lucide-react": "1.28.0",
    "monaco-editor": "0.56.0",
    "next": "16.2.11",
    "otpauth": "9.5.1",
    "payload": "3.86.0",
    "pino": "9.14.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.6.7",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sharp": "0.35.0",
    "tailwind-merge": "3.6.0",
    "tr46": "6.0.0",
    "tw-animate-css": "1.4.0",
    "unicode-script": "1.2.0",
    "yjs": "13.6.31",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1101.0",
    "@aws-sdk/s3-request-presigner": "3.1101.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/ali-oss": "6.23.3",
    "@types/node": "22.19.9",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/tr46": "5.0.1",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "jsdom": "28.0.0",
    "msw": "2.15.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.7.0"
  }
}
